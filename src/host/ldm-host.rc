// Version information for ldm-host.exe, so Windows names it properly, for example when an
// installer asks to close it. The version numbers come from CMakeLists.txt (src/host/CMakeLists.txt).
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LDM_VERSION_MAJOR, LDM_VERSION_MINOR, LDM_VERSION_PATCH, 0
 PRODUCTVERSION LDM_VERSION_MAJOR, LDM_VERSION_MINOR, LDM_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Last Download Manager contributors"
            VALUE "FileDescription", "Last Download Manager browser helper"
            VALUE "FileVersion", LDM_VERSION_STRING
            VALUE "InternalName", "ldm-host"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "ldm-host.exe"
            VALUE "ProductName", "Last Download Manager"
            VALUE "ProductVersion", LDM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
