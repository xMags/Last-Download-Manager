IDD_PROGRESS DIALOGEX 0, 0, 330, 262
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Download progress"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_PROG_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 316, 128
    LTEXT "Address:", IDC_PROG_L_URL, 16, 28, 62, 8
    EDITTEXT IDC_PROG_URL, 80, 27, 236, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT "Status:", IDC_PROG_L_STATUS, 16, 42, 62, 8
    LTEXT "", IDC_PROG_STATUS, 80, 42, 236, 8, SS_ENDELLIPSIS
    LTEXT "File size:", IDC_PROG_L_SIZE, 16, 56, 62, 8
    LTEXT "", IDC_PROG_SIZE, 80, 56, 236, 8
    LTEXT "Downloaded:", IDC_PROG_L_DOWNLOADED, 16, 70, 62, 8
    LTEXT "", IDC_PROG_DOWNLOADED, 80, 70, 236, 8
    LTEXT "Transfer rate:", IDC_PROG_L_RATE, 16, 84, 62, 8
    LTEXT "", IDC_PROG_RATE, 80, 84, 236, 8
    LTEXT "Time left:", IDC_PROG_L_LEFT, 16, 98, 62, 8
    LTEXT "", IDC_PROG_LEFT, 80, 98, 236, 8
    LTEXT "Resume capability:", IDC_PROG_L_RESUME, 16, 112, 62, 8
    LTEXT "", IDC_PROG_RESUME, 80, 112, 236, 8
    CONTROL "", IDC_PROG_BAR, "msctls_progress32", 0, 7, 140, 316, 9
    AUTOCHECKBOX "&Use the speed limiter for this download", IDC_PROG_LIMIT_ENABLE, 16, 30, 280, 10, WS_TABSTOP
    EDITTEXT IDC_PROG_LIMIT_VALUE, 28, 46, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "KB/sec", IDC_PROG_LIMIT_UNIT, 92, 48, 40, 8
    AUTOCHECKBOX "&Remember this limit for this file", IDC_PROG_LIMIT_REMEMBER, 28, 66, 250, 10, WS_TABSTOP
    LTEXT "The limit applies at once and also counts toward the global speed limiter.", IDC_PROG_LIMIT_HINT, 16, 86, 290, 18
    AUTOCHECKBOX "&Show the download complete dialog", IDC_PROG_SHOW_COMPLETE, 16, 30, 280, 10, WS_TABSTOP
    LTEXT "&When this download is complete:", IDC_PROG_ACTION_LABEL, 16, 48, 150, 8
    COMBOBOX IDC_PROG_ACTION, 16, 60, 160, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "<< &Hide details", IDC_PROG_DETAILS, 7, 154, 70, 14, WS_TABSTOP
    PUSHBUTTON "&Pause", IDC_PROG_PAUSE, 199, 154, 60, 14, WS_TABSTOP
    PUSHBUTTON "S&top", IDCANCEL, 263, 154, 60, 14, WS_TABSTOP
    CONTROL "", IDC_PROG_SEGMENTS, "Static", SS_OWNERDRAW, 7, 175, 316, 12
    CONTROL "", IDC_PROG_CONNECTIONS, "SysListView32", LVS_REPORT | LVS_NOSORTHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 191, 316, 64
END

