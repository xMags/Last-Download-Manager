    AUTOCHECKBOX "Save the &pages too, linked to the saved files for offline browsing", IDC_GW_SAVE_PAGES, 20, 114, 290, 10, WS_TABSTOP
    AUTOCHECKBOX "&Replace files that already exist", IDC_GW_OVERWRITE, 20, 130, 290, 10, WS_TABSTOP
    AUTOCHECKBOX "Add the checked files to the &main list when the Grabber window closes", IDC_GW_ADD_ON_CLOSE, 20, 146, 290, 10, WS_TABSTOP
    LTEXT "Saved pages need one folder for their links: in category folders, the pages and files go to the General category's folder.", IDC_GW_SAVE_NOTE, 20, 166, 290, 18
    // Page 3: which pages to explore
    LTEXT "Pages to explore on the start page's site:", 1760, 10, 28, 300, 8
    AUTORADIOBUTTON "The &whole site", IDC_GW_WHOLE_SITE, 20, 42, 120, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Links up to", IDC_GW_LEVELS, 20, 58, 58, 10
    EDITTEXT IDC_GW_LEVELS_COUNT, 80, 56, 24, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "levels away from the start page", 1764, 108, 58, 200, 8
    LTEXT "Follow links into &other sites for", 1765, 10, 80, 118, 8
    EDITTEXT IDC_GW_OTHER_LEVELS, 132, 78, 24, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "levels (0: not at all)", 1767, 160, 80, 150, 8
    AUTOCHECKBOX "Stay below the start page's fol&der", IDC_GW_NO_PARENT, 10, 98, 300, 10, WS_TABSTOP
    AUTOCHECKBOX "Treat every site in the start page's &domain as the same site", IDC_GW_MAIN_DOMAIN, 10, 114, 300, 10, WS_TABSTOP
    LTEXT "E&xplore only these paths:", 1770, 10, 134, 112, 8
    EDITTEXT IDC_GW_EXPLORE_INCLUDE, 125, 132, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Never explore these paths:", 1772, 10, 152, 112, 8
    EDITTEXT IDC_GW_EXPLORE_EXCLUDE, 125, 150, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Masks such as /docs/ or */private/*, separated by spaces.", 1774, 125, 166, 195, 8
    LTEXT "Pages read at the &same time:", 1775, 10, 184, 112, 8
    EDITTEXT IDC_GW_EXPLORE_CONCURRENCY, 125, 182, 24, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "(1 to 10)", 1777, 153, 184, 60, 8
    // Page 4: which files to list
    LTEXT "&File types to list:", 1780, 10, 28, 112, 8
    EDITTEXT IDC_GW_TYPES_INCLUDE, 125, 26, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "File types to &leave out:", 1782, 10, 46, 112, 8
    EDITTEXT IDC_GW_TYPES_EXCLUDE, 125, 44, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Masks such as *.jpg *.png; nothing lists every type.", 1784, 125, 60, 195, 8
    LTEXT "Si&ze at least:", 1785, 10, 76, 112, 8
    EDITTEXT IDC_GW_MIN_KB, 125, 74, 50, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "KB, at &most", 1787, 179, 76, 44, 8
    EDITTEXT IDC_GW_MAX_KB, 225, 74, 50, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "KB", 1789, 279, 76, 20, 8
    LTEXT "Only files in these pat&hs:", 1790, 10, 94, 112, 8
    EDITTEXT IDC_GW_FILES_INCLUDE, 125, 92, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Leave out files in these p&aths:", 1792, 10, 112, 112, 8
    EDITTEXT IDC_GW_FILES_EXCLUDE, 125, 110, 195, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Only files on the start page's s&ite", IDC_GW_THIS_SITE, 10, 130, 300, 10, WS_TABSTOP
    AUTOCHECKBOX "List each address only &once", IDC_GW_DUPLICATES, 10, 144, 300, 10, WS_TABSTOP
    AUTOCHECKBOX "Download the matching files &while exploring", IDC_GW_IMMEDIATELY, 10, 158, 300, 10, WS_TABSTOP
    AUTOCHECKBOX "Use the link &text as the description", IDC_GW_LINK_TEXT, 10, 172, 300, 10, WS_TABSTOP
    LTEXT "Downloads at the same tim&e:", 1798, 10, 190, 112, 8
    EDITTEXT IDC_GW_DOWNLOAD_CONCURRENCY, 125, 188, 24, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "(1 to 10)", IDC_GW_P4_LAST, 153, 190, 60, 8
    PUSHBUTTON "< &Back", IDC_GW_BACK, 120, 220, 50, 14, WS_TABSTOP
    PUSHBUTTON "N&ext >", IDC_GW_NEXT, 172, 220, 50, 14, WS_TABSTOP
    DEFPUSHBUTTON "&Finish", IDC_GW_FINISH, 224, 220, 50, 14, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 276, 220, 50, 14, WS_TABSTOP
END

