IDD_FIND DIALOGEX 0, 0, 290, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Fi&nd what:", -1, 7, 9, 45, 8
    EDITTEXT IDC_FIND_TEXT, 55, 7, 165, 13, ES_AUTOHSCROLL | WS_TABSTOP
