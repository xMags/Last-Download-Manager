    CONTROL "", IDC_SCHED_START_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 215, 40, 60, 13
    AUTORADIOBUTTON "&Once on", IDC_SCHED_ONCE, 144, 59, 60, 10, WS_GROUP | WS_TABSTOP
    CONTROL "", IDC_SCHED_DATE, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 215, 57, 80, 13
