IDD_SITE_SIGNIN DIALOGEX 0, 0, 260, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sign in on sites"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Some videos play only for a signed-in account: on Vimeo, Instagram, Reddit, and age-restricted YouTube. For the sites you check, LDM gives yt-dlp your browser's cookies for that site, for that page only. They go nowhere else and are not kept.", -1, 7, 7, 246, 42
    CONTROL "", IDC_SI_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 52, 246, 104
    LTEXT "YouTube: Google may flag or suspend an account that programs use. Use a second account if you want to be safe.", -1, 7, 162, 246, 26
    DEFPUSHBUTTON "OK", IDOK, 149, 203, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 203, 203, 50, 14
END

