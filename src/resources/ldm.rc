    EDITTEXT IDC_SCHED_QUOTA_MB, 196, 24, 50, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "MB every", IDC_SCHED_QUOTA_MB_UNIT, 250, 26, 34, 8
    EDITTEXT IDC_SCHED_QUOTA_HOURS, 286, 24, 26, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "hours", IDC_SCHED_QUOTA_HOURS_UNIT, 316, 26, 40, 8
    AUTOCHECKBOX "Show a war&ning before stopping", IDC_SCHED_QUOTA_WARN, 144, 44, 200, 10, WS_TABSTOP
    LTEXT "The download quota applies to every download, as in Options > Connection.", IDC_SCHED_QUOTA_NOTE, 132, 62, 292, 17
    PUSHBUTTON "&Start now", IDC_SCHED_START_NOW, 124, 242, 60, 14, WS_TABSTOP
    PUSHBUTTON "S&top", IDC_SCHED_STOP, 188, 242, 60, 14, WS_TABSTOP
    PUSHBUTTON "&Apply", IDC_SCHED_APPLY, 309, 242, 60, 14, WS_TABSTOP
    PUSHBUTTON "Close", IDCANCEL, 373, 242, 60, 14, WS_TABSTOP
