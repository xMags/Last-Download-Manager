    AUTOCHECKBOX "Tue", 1657, 194, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Wed", 1658, 232, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Thu", 1659, 270, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Fri", 1660, 308, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Sat", 1661, 346, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Sun", 1662, 384, 89, 36, 10, WS_TABSTOP
    AUTOCHECKBOX "Start again &every", IDC_SCHED_REPEAT, 144, 106, 72, 10, WS_TABSTOP
    EDITTEXT IDC_SCHED_REPEAT_MINUTES, 218, 104, 30, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "minutes, until the stop time or midnight", IDC_SCHED_REPEAT_UNIT, 252, 106, 172, 8
    AUTOCHECKBOX "&Stop the queue at", IDC_SCHED_STOP_AT, 132, 125, 80, 10, WS_TABSTOP
    CONTROL "", IDC_SCHED_STOP_TIME, "SysDateTimePick32", DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 215, 123, 60, 13
    LTEXT "LDM has to be running at these times; in the tray is enough. A start that passes while LDM is closed is skipped.", IDC_SCHED_NOTE, 132, 143, 292, 17
    LTEXT "", IDC_SCHED_WAKE_NOTE, 132, 162, 292, 17
