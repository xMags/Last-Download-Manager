    PUSHBUTTON "Move &up", IDC_SCHED_UP, 374, 26, 52, 14, WS_TABSTOP
    PUSHBUTTON "Move do&wn", IDC_SCHED_DOWN, 374, 44, 52, 14, WS_TABSTOP
    PUSHBUTTON "&Remove", IDC_SCHED_REMOVE, 374, 62, 52, 14, WS_TABSTOP
