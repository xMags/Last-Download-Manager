    DEFPUSHBUTTON "&Open", IDC_DONE_OPEN, 50, 80, 60, 14, WS_TABSTOP
    PUSHBUTTON "Open &with...", IDC_DONE_OPEN_WITH, 114, 80, 60, 14, WS_TABSTOP
    PUSHBUTTON "Open &folder", IDC_DONE_FOLDER, 178, 80, 60, 14, WS_TABSTOP
    PUSHBUTTON "Close", IDCANCEL, 263, 80, 60, 14, WS_TABSTOP
    AUTOCHECKBOX "&Don't show this dialog again", IDC_DONE_DONT_SHOW, 50, 102, 200, 10, WS_TABSTOP
END

