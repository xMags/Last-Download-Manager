    LTEXT "width", -1, 176, 46, 22, 8
    EDITTEXT IDC_BATCH_WIDTH, 200, 44, 24, 13, ES_NUMBER | WS_TABSTOP
    AUTORADIOBUTTON "&Letters from", IDC_BATCH_LETTERS, 7, 64, 62, 10
    EDITTEXT IDC_BATCH_FROM_LETTER, 72, 62, 20, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "to", -1, 116, 64, 10, 8
    EDITTEXT IDC_BATCH_TO_LETTER, 128, 62, 20, 13, ES_AUTOHSCROLL | WS_TABSTOP
