IDD_ABOUT DIALOGEX 0, 0, 250, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Last Download Manager"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON IDI_LDM, IDC_ABOUT_ICON, 10, 10, 20, 20
    LTEXT "Last Download Manager", IDC_ABOUT_TITLE, 45, 10, 198, 12
