    LTEXT "Login:", -1, 90, 85, 24, 8
    EDITTEXT IDC_BATCH_USER, 116, 83, 80, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Password:", -1, 202, 85, 36, 8
    EDITTEXT IDC_BATCH_PASSWORD, 240, 83, 83, 13, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
