    LTEXT "Address:", -1, 50, 10, 45, 8
    EDITTEXT IDC_DONE_URL, 97, 9, 226, 10, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT "Saved as:", -1, 50, 24, 45, 8
