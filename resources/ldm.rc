    LTEXT "", IDC_BATCH_FIRST, 14, 114, 302, 8, SS_ENDELLIPSIS
    LTEXT "", IDC_BATCH_SECOND, 14, 126, 302, 8, SS_ENDELLIPSIS
    LTEXT "", IDC_BATCH_LAST, 14, 138, 302, 8, SS_ENDELLIPSIS
