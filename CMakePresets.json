{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
        "VCPKG_INSTALLED_DIR": "$env{LOCALAPPDATA}/LastDownloadManager-dev/vcpkg_installed"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-release-arm64",
      "displayName": "Windows ARM64 Release (cross-compiled from an x64 developer shell for ARM64)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static",
        "LDM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows x64 Debug with AddressSanitizer",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LDM_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-analyze",
      "displayName": "Windows x64 Debug with MSVC code analysis",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LDM_ENABLE_ANALYZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-release-arm64", "configurePreset": "windows-release-arm64" },
    { "name": "windows-asan", "configurePreset": "windows-asan" },
    { "name": "windows-analyze", "configurePreset": "windows-analyze" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
