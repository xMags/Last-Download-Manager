{
  "manifest_version": 3,
  "name": "Last Download Manager",
  "description": "Download files with Last Download Manager",
  "version": "0.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "ldm-integration@mrdevfx.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/ldm-16.png",
    "48": "icons/ldm-48.png",
    "128": "icons/ldm-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/ldm-16.png",
      "32": "icons/ldm-32.png"
    },
    "default_title": "Last Download Manager"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "alarms",
    "cookies",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/page-keys.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
